# Copia este archivo como .env.local y rellena los valores (ver docs/supabase.md).
# Son valores PÚBLICOS por diseño: viajan dentro de la app. La seguridad la ponen las políticas RLS.
# NUNCA pongas aquí la clave `service_role` / secret de Supabase.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional: página de descargas que enlaza /descargar (GitHub Releases)
# VITE_DOWNLOADS_URL=https://github.com/TU-USUARIO/TU-REPO/releases/latest
