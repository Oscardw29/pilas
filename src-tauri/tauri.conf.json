{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pilas",
  "mainBinaryName": "Pilas",
  "version": "2.0.0",
  "identifier": "app.pilas.habitos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --strictPort",
    "beforeBuildCommand": "npm run build:tauri-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "¡Pilas!",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0c0c10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob: https://*.supabase.co",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://generativelanguage.googleapis.com https://api.openai.com https://api.groq.com https://openrouter.ai https://api.elevenlabs.io https://api.deepgram.com",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "Pilas",
    "category": "Productivity",
    "shortDescription": "Hábitos, rachas y un coach de IA",
    "longDescription": "¡Pilas! te ayuda a construir hábitos con versiones mínimas, rachas y un coach de IA. Tus datos se guardan en el dispositivo y se sincronizan cifrados de extremo a extremo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
