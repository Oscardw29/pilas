<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Fondo y barras del sistema con el color de la app (tema oscuro por defecto, como la web).
             En cuanto carga la web, PilasSystemBarsPlugin los cambia al tema elegido. -->
        <item name="android:windowBackground">@color/pilas_bg_dark</item>
        <item name="android:statusBarColor">@color/pilas_bg_dark</item>
        <item name="android:navigationBarColor">@color/pilas_bg_dark</item>
    </style>

    <!-- Capas que PilasSystemBarsPlugin aplica al tema según el de la app -->
    <style name="PilasBarsDark">
        <item name="android:windowBackground">@color/pilas_bg_dark</item>
    </style>

    <style name="PilasBarsLight">
        <item name="android:windowBackground">@color/pilas_bg_light</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>