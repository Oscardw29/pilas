<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin copias de seguridad en la nube de Google ni transferencia entre dispositivos:
  la base local (IndexedDB) guarda datos personales, la sesión y las claves de cifrado del dispositivo.
  Los datos ya viajan cifrados de extremo a extremo con la sincronización de la cuenta.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
